{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build/server",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server.ts",
    "src/types.ts",
    "src/utils/pqcCrypto.ts",
    "src/engines/**/*.mjs",
    "src/infrastructure/ipfs-store.mjs",
    "src/infrastructure/storage-handler.mjs"
  ]
}
