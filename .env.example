# SHOR x402 Environment Configuration Template

# Gemini API Key for Autonomous Agent Planning & Synthesis (Aether AI)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Algorand Node & Indexer Endpoints (AlgoNode Free Public Infrastructure)
ALGOD_MAINNET_URL=https://mainnet-api.algonode.cloud
ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
INDEXER_MAINNET_URL=https://mainnet-idx.algonode.cloud
INDEXER_TESTNET_URL=https://testnet-idx.algonode.cloud

# Server & Netlify Deployment Port
PORT=3000
NODE_ENV=production
